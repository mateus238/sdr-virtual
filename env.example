APP_ENV=development            # production exige SECRET_KEY
SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
PHONE_PEPPER=                  # opcional; padrão = SECRET_KEY (não mude depois, invalida a supressão)
DATABASE_PATH=data/sdr.db
UPLOAD_DIR=data/uploads
TIMEZONE=America/Sao_Paulo
PORT=8080

# WhatsApp (mock = nada é enviado; cloud = Meta Cloud API oficial)
WHATSAPP_PROVIDER=mock
WA_GRAPH_VERSION=v21.0
WA_VERIFY_TOKEN=troque-este-token
WA_APP_SECRET=                 # App Secret do app Meta (valida X-Hub-Signature-256)

# IA (sem chave usa o analisador heurístico, só para teste)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT=30

# Operação
INBOUND_DEBOUNCE_SECONDS=3
RETENTION_DAYS=365
SESSION_HOURS=12
HANDOFF_WEBHOOK_URL=           # opcional: n8n/CRM recebe o handoff
WORKER_POLL_SECONDS=1.0
ADMIN_EMAIL=admin@example.com  # usado só na primeira execução
ADMIN_PASSWORD=                # vazio = gera uma senha e mostra no console

# --- Provedor "qr" (OPCIONAL, NÃO OFICIAL: WhatsApp Web via bridge/ Node+Baileys). Risco de banimento do número. ---
QR_BRIDGE_URL=http://127.0.0.1:3100
QR_BRIDGE_TOKEN=troque-por-um-segredo-longo   # o mesmo valor no servidor Python e na bridge
QR_DEFAULT_DAILY_LIMIT=50
# variáveis da bridge (bridge/server.js): BRIDGE_PORT=3100 BRIDGE_HOST=127.0.0.1 APP_URL=http://127.0.0.1:8080 BRIDGE_AUTH_DIR=./auth
